# Nexus Desk — one env surface for the buyer.
# Paper mode needs ZERO exchange keys (public Kraken market data only).
# Add Kraken keys only when you intentionally arm live.

# --- Required shape (defaults are fine for paper) ---
NEXUS_PAPER_ONLY=1
NEXUS_TRADE_SYMBOL=BTC/USD
NEXUS_LOOP_INTERVAL=120
NEXUS_SCALP_SL_PCT=0.0035
NEXUS_SCALP_TP_PCT=0.008
NEXUS_SCALP_POSITION_USD=25
NEXUS_SCALP_INTERVAL_MIN=1
NEXUS_SCALP_VWAP_WINDOW=20

# --- Optional: live arming (leave blank for paper template) ---
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
NEXUS_DASHBOARD_ALLOW_LIVE_ARM=0
NEXUS_CONTROL_PASSWORD=

# --- Optional: research scorecard URL (Critical-Mass-Lab or static file) ---
NEXUS_SCORECARD_URL=

# --- Optional: TypeSafe Jev compare on Engine (paper research only; never arms live) ---
# Leave blank for zero-secret paper. Set a key only if you want Ask Jev on /core.
TYPESAFE_API_KEY=
# NEXUS_JEV_API_KEY=
NEXUS_JEV_MODEL=jev-latest

# --- Host ---
PORT=8080
NEXUS_PRODUCT_NAME=Nexus Desk
